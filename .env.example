#Este .env sirve cuando se ejecuta el proyecto con Docker-compose.
#Con Docker-compose no se debe definir la variable EXPO_PUBLIC_API_URL.

EXPO_PUBLIC_FIREBASE_API_KEY=apiKey
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=authDomain
EXPO_PUBLIC_FIREBASE_PROJECT_ID=projectId
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=storageBucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=senderId
EXPO_PUBLIC_FIREBASE_APP_ID=appId

DB_USER=user
DB_PASSWORD=your_password
DB_HOST=db
DB_PORT=5432
DB_NAME=carshop_service

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@xxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

PORT=3000